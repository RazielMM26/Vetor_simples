using System;

public class Program
{
    public static void Main()
    {
        do
        {
            string[] alunos = new string[6];
            for (int i = 0; i < 6; i++)
            {
                Console.Write("Insira o nome do aluno: ");
                alunos[i] = Console.ReadLine();
            }

            Console.Write("Gostaria de buscar um aluno? (s/n) ");
            string opcao_busca = Console.ReadLine();

            if (opcao_busca == "s")
            {
                Console.Write("Insira o nome que você deseja buscar: ");
                string aluno_busca = Console.ReadLine();

                int posicao = -1;
                for (int i = 0; i < 6; i++)
                {
                    if (aluno_busca == alunos[i])
                    {
                        posicao = i;
                        break; // ← para de procurar
                    }
                }

                if (posicao != -1)
                {
                    Console.WriteLine($"Aluno encontrado na posição {posicao}!");
                    Console.Write("Gostaria de editar o nome? (s/n) ");
                    string opcao_edit = Console.ReadLine();
                    if (opcao_edit == "s")
                    {
                        Console.Write("Digite o novo valor: ");
                        alunos[posicao] = Console.ReadLine();
                        Console.WriteLine("Nome atualizado.");
                    }
                }
                else
                {
                    Console.WriteLine("Aluno não encontrado.");
                }
            }

            Console.Write("Gostaria de iniciar o processo novamente? (s/n) ");
            string opcao_loop = Console.ReadLine();
        } while (opcao_loop == "s");
    }
}   
